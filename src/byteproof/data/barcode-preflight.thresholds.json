{
  "version": "1",
  "organ": "barcode-preflight",
  "modes": ["check", "gs1", "symbol", "oracle"],
  "severity_order": {"ok": 0, "info": 1, "warn": 2, "error": 3},
  "verdicts": ["pass", "warn", "fail"],
  "fail_on_choices": ["none", "warn", "error"],
  "threshold_statuses": ["verified", "unverified", "not-applicable"],
  "basis_kinds": ["gen-spec", "engineering-heuristic"],
  "supported_symbols": ["code128", "gs1-128", "ean13", "ean8", "upca", "datamatrix", "qr", "code39"],
  "illuminations": ["white", "red", "ir"],
  "print_fields": ["symbol", "x_dimension_mm", "target_dpi", "quiet_zone_mm"],
  "print_color_fields": ["bar_color", "space_color", "illumination"],
  "quiet_zone_sides": ["left", "right", "top", "bottom"],
  "charsets": {
    "N": "0123456789",
    "X": "!\"%&'()*+,-./0123456789:;<=>?ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz",
    "Y": "#-/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "Z": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  },
  "rule_verdicts": {
    "bp-gate": "error",
    "bp-gs1-charset": "error",
    "bp-gs1-checksum": "error",
    "bp-gs1-date": "error",
    "bp-gs1-exclusive": "error",
    "bp-gs1-length": "error",
    "bp-gs1-malformed": "error",
    "bp-gs1-required": "error",
    "bp-gs1-skipped": "info",
    "bp-gs1-unknown-ai": "error",
    "bp-oracle-agreement": "warn",
    "bp-oracle-absent": "info",
    "bp-print-bar-height": "error",
    "bp-print-color": "error",
    "bp-print-incomplete": "error",
    "bp-print-magnification": "warn",
    "bp-print-quiet-zone": "error",
    "bp-print-quiet-zone-absent": "error",
    "bp-print-raster": "error",
    "bp-print-unmodelled": "info",
    "bp-summary": "info",
    "bp-symbol-capacity": "error",
    "bp-symbol-charset": "error",
    "bp-symbol-checksum": "error",
    "bp-symbol-length": "error",
    "bp-symbol-plan": "info",
    "bp-symbol-unsupported": "warn"
  }
}