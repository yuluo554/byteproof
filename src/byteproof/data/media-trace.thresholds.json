{
  "version": "1",
  "organ": "media-trace",
  "modes": ["audit"],
  "modules": ["M1", "M2", "M3", "M4", "M5"],
  "policy": {
    "tick_tolerance": 1,
    "timescale_suspect_below": 100,
    "matrix_ortho_tolerance": 1,
    "dts_regression_tolerance": 0,
    "rate_one": 65536,
    "q16_one": 65536,
    "stts_width_max": 4294967295,
    "tfdt_v0_width_max": 4294967295
  },
  "known_priming": {"mp4a": 1024, "aac": 1024, "alac": 0, "opus": 0},
  "roll_distance_codecs": ["ac-3", "ec-3", "dtsc", "dtsh", "dtsl"],
  "statuses": ["fail", "gray"],
  "exit_priority": "fail > gray > pass",
  "code_rule": {
    "too_small_size": "mt-too-small-size",
    "child_overruns_parent": "mt-child-overruns-parent",
    "duplicate_moov": "mt-duplicate-moov",
    "duplicate_mdat": "mt-duplicate-mdat",
    "stco_out_of_mdat": "mt-stco-out-of-mdat",
    "truncated_mdat": "mt-truncated-mdat",
    "ftyp_brand_mismatch": "mt-ftyp-brand-mismatch",
    "max_depth_exceeded": "mt-max-depth-exceeded",
    "duration_mismatch": "mt-duration-mismatch",
    "elst_item_rate_not_one": "mt-elst-item-rate-not-one",
    "elst_item_order_suspect": "mt-elst-item-order-suspect",
    "empty_edit": "mt-empty-edit",
    "first_pts_outside_media": "mt-first-pts-outside-media",
    "duration_unknown": "mt-duration-unknown",
    "tfdt_regression": "mt-tfdt-regression",
    "zero_duration_entry": "mt-zero-duration-entry",
    "dts_overflow_risk": "mt-dts-overflow-risk",
    "dts_regression": "mt-dts-regression",
    "timescale_suspect": "mt-timescale-suspect",
    "vfr_detected": "mt-vfr-detected",
    "priming_undeclared": "mt-priming-undeclared",
    "start_trim": "mt-start-trim",
    "priming_mismatch": "mt-priming-mismatch",
    "no_roll_distance": "mt-no-roll-distance",
    "no_edts_but_nonzero_start": "mt-no-edts-but-nonzero-start",
    "unknown_codec_priming": "mt-unknown-codec-priming",
    "matrix_not_orthogonal": "mt-matrix-not-orthogonal",
    "rotation_dimension_conflict": "mt-rotation-dimension-conflict",
    "sar_dar_conflict": "mt-sar-dar-conflict",
    "colr_multi_instance": "mt-colr-multi-instance",
    "hdr_metadata_missing": "mt-hdr-metadata-missing",
    "hdr_range_suspect": "mt-hdr-range-suspect"
  }
}