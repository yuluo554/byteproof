{
  "version": "1",
  "organ": "crsscope",
  "modes": ["decl", "detect", "xdiff", "geojson", "tiles", "report"],
  "default_mode": "decl",
  "verdicts": {
    "crs-check-finding": "info",
    "crs-decl-axis": "info",
    "crs-decl-extent": "info",
    "crs-decl-magnitude": "info",
    "crs-decl-mixed": "info",
    "crs-decl-unit": "info",
    "crs-detect-winner": "info",
    "crs-gray-zone": "info",
    "crs-geojson-axis": "info",
    "crs-geojson-bbox": "info",
    "crs-geojson-crs-member": "info",
    "crs-geojson-nesting": "info",
    "crs-geojson-null-geometry": "info",
    "crs-geojson-precision": "info",
    "crs-geojson-ring-order": "info",
    "crs-module-verdict": "info",
    "crs-residual": "info",
    "crs-structure-error": "info",
    "crs-summary": "info",
    "crs-tiles-axis-flip": "info",
    "crs-tiles-mixed": "info",
    "crs-tiles-wrap": "info",
    "crs-tiles-y-range": "info",
    "crs-tiles-zoom-bbox": "info",
    "crs-xdiff-boundary-table": "info",
    "crs-xdiff-implementations": "info",
    "crs-xdiff-jumps": "info",
    "crs-xdiff-not-converged": "info",
    "crs-xdiff-pairwise": "info"
  },
  "status_to_verdict": {
    "conflict": "error",
    "error": "error",
    "warning": "warn",
    "undecidable": "warn",
    "info": "info",
    "consistent": "info"
  },
  "thresholds": {
    "degree_max": 180.0,
    "metre_min": 1000000.0,
    "lat_range_max": 90.0,
    "min_axis_samples": 5,
    "precision_max_fraction_digits": 9,
    "boundary_band_deg": 0.05,
    "weight_boundary": 0.25,
    "weight_declared": 0.3,
    "confidence_high_margin": 0.15,
    "confidence_medium_margin": 0.05,
    "min_evaluable_points": 30,
    "unknown_coastal_max_ratio": 0.8,
    "mask_max_resolution_deg": 1.0,
    "inverse_tolerance_deg": 1e-06,
    "inverse_max_iter": 100
  },
  "declared_crs_choices": ["4326", "3857", "4490", "crs84"],
  "hypotheses": ["WGS84", "GCJ02", "BD09"],
  "target_choices": ["wgs84", "gcj02", "bd09", "webmercator"],
  "implementations": ["coordTransform_py", "gcoord", "proj4js_webmercator"],
  "flip_formula": "2**z - 1 - y",
  "bbox_profiles": {
    "coordTransform_py": { "lon": [73.66, 135.05], "lat": [3.86, 53.55], "closed": false },
    "gcoord": { "lon": [72.004, 137.8347], "lat": [0.8293, 55.8271], "closed": true }
  }
}
