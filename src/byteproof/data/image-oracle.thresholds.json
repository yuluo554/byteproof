{
  "version": "1",
  "organ": "image-oracle",
  "modes": ["orientation", "double-rotate", "color", "container", "consumers"],
  "severity_order": {"info": 0, "suspicion": 0, "warning": 1, "error": 2, "unknown": 2},
  "risk_by_severity": {"info": "low", "suspicion": "low", "warning": "medium", "error": "high", "unknown": "unknown"},
  "orientation_matrix": {
    "1": [false, false, 0, false],
    "2": [true, false, 0, false],
    "3": [false, false, 180, false],
    "4": [false, true, 0, false],
    "5": [true, false, 270, true],
    "6": [false, false, 90, true],
    "7": [true, false, 90, true],
    "8": [false, false, 270, true]
  },
  "rotating_values": [5, 6, 7, 8],
  "encoding_tag": 274,
  "consumers": ["chrome", "safari", "firefox", "macos_preview", "windows_photos", "imagemagick", "libvips", "sharp", "exiftran"],
  "columns": ["applies_orientation", "applies_icc", "dropped_chunks", "double_rotate_risk", "frame_duration"],
  "value_vocab": {
    "applies_orientation": ["yes", "partial", "no", "unknown"],
    "applies_icc": ["yes", "no", "unknown"],
    "double_rotate_risk": ["low", "medium", "high", "unknown"],
    "frame_duration": ["per-container-unit", "unknown", "n/a"]
  },
  "risk_levels": ["high", "medium", "low", "unknown"],
  "confidences": ["certain", "single-source", "gray"],
  "default_assumption_rows": 7,
  "processing_commands": [
    "oxipng --strip safe",
    "jpegtran -copy none",
    "jpegtran -copy all",
    "exiftool -all=",
    "magick -strip",
    "sharp .withMetadata(false)"
  ],
  "frame_unit": {"gif": "1/100s", "png": "num/den", "webp": "ms", "avif": "not-in-band"},
  "rule_verdicts": {
    "io-color-bitdepth": "info",
    "io-color-cmyk": "info",
    "io-color-defaults": "info",
    "io-color-icc": "info",
    "io-color-icc-class": "info",
    "io-color-icc-gap": "info",
    "io-color-icc-header": "info",
    "io-color-icc-space": "info",
    "io-color-icc-unknown": "info",
    "io-color-iccp-srgb": "info",
    "io-color-markers": "info",
    "io-consumers-diff": "info",
    "io-consumers-matrix": "info",
    "io-consumers-risk": "info",
    "io-container-apng": "info",
    "io-container-frame": "info",
    "io-container-gif": "info",
    "io-container-jpeg": "info",
    "io-container-png-crc": "info",
    "io-container-png-order": "info",
    "io-container-webp": "info",
    "io-double-bigedge": "info",
    "io-double-ifd1": "info",
    "io-double-xmp": "info",
    "io-gate": "error",
    "io-orientation": "info",
    "io-orientation-absent": "info",
    "io-orientation-range": "info",
    "io-orientation-type": "info",
    "io-orientation-xmp": "info",
    "io-summary": "info"
  }
}